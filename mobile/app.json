{
  "expo": {
    "name": "Econexa Mobile",
    "slug": "econexa-mobile",
    "version": "1.0.0",
    "sdkVersion": "57.0.0",
    "scheme": "mutira",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "br.com.mutira",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      "expo-secure-store",
      "@react-native-google-signin/google-signin"
    ]
  }
}
