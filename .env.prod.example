# Copie para .env.prod (ignorado pelo git) e preencha. Suba com:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# Os dois domínios precisam apontar (registro A/AAAA) para o servidor antes de subir:
# o Caddy emite os certificados HTTPS sozinho.

DOMINIO_API=api.mutira.exemplo
DOMINIO_ARQUIVOS=arquivos.mutira.exemplo

POSTGRES_USER=mutira
# Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=mutira_db

MINIO_ROOT_USER=mutira
# Gere com: openssl rand -hex 24
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=econexa-evidencias

# Gere com: openssl rand -hex 32 (mínimo de 32 caracteres em produção)
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Origens do navegador que podem chamar a API (o app nativo não precisa de CORS)
CORS_ORIGINS=https://mutira.exemplo
APP_PUBLIC_URL=https://mutira.exemplo
API_PUBLIC_URL=https://api.mutira.exemplo

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Mutira <nao-responda@mutira.exemplo>
SMTP_ALLOW_EXTERNAL=true

GOOGLE_CLIENT_IDS=
CONTATO_PRIVACIDADE=privacidade@mutira.exemplo

BACKUP_HORARIO=03:00
BACKUP_RETENCAO_DIAS=14
